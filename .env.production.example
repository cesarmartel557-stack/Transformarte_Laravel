APP_NAME="TransformArte"
APP_ENV=production
APP_KEY=base64:+RmZk5bdlTyqbMKq0ddSl5lU3DEU6KLD8AicOufzHP0=
APP_DEBUG=false
APP_URL=https://espaciotransformarte.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=daily
LOG_LEVEL=error

# --------------------------------------------------------------------------
# --------------------------------------------------------------------------
# BASE DE DATOS (SQLITE)
# --------------------------------------------------------------------------
DB_CONNECTION=sqlite
# Laravel resuelve automáticamente database/database.sqlite si no se especifica ruta:
# DB_DATABASE=

# Si prefieres usar MySQL en algún momento:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=uXXXXX_transformarte
# DB_USERNAME=uXXXXX_usuario
# DB_PASSWORD=TuPasswordDeHostingerAqui

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=database
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=public

# --------------------------------------------------------------------------
# CORREO ELECTRÓNICO (HOSTINGER SMTP)
# --------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=hola@espaciotransformarte.com
MAIL_PASSWORD="TuPasswordDeEmail"
MAIL_FROM_ADDRESS=hola@espaciotransformarte.com
MAIL_FROM_NAME="Espacio TransformArte"

# --------------------------------------------------------------------------
# CLOUDFLARE TURNSTILE (ANTISPAM PRODUCCIÓN)
# --------------------------------------------------------------------------
TURNSTILE_SITE_KEY=tu_site_key_real_de_cloudflare
TURNSTILE_SECRET_KEY=tu_secret_key_real_de_cloudflare
